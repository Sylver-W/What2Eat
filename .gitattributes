# 让 Git 自动统一换行符为 LF（最推荐）
* text=auto

# 强制 LF（推荐给 js/json/wxml/wxss）
*.js     text eol=lf
*.json   text eol=lf
*.wxml   text eol=lf
*.wxss   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# 二进制文件不处理换行符
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp3 binary
*.mp4 binary
*.apk binary
*.zip binary
