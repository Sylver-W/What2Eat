/* 页面容器 */
.canteen-container {
  background-color: #f5f2f2;
  min-height: 100vh;
  padding-bottom: 100rpx; /* 适配底部 tabbar */
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-bottom: 2rpx solid #f3f3f3;
}

.back-icon {
  font-size: 36rpx;
  color: #101010;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #101010;
}

/* 食堂列表 */
.canteen-list {
  padding: 30rpx;
}

/* 食堂卡片 */
.canteen-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.canteen-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #101010;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

/* 食堂信息项 */
.canteen-info {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
}

.info-icon {
  font-size: 26rpx;
  color: #3a7afe;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.info-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 40rpx;
}