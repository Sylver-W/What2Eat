.container {
  padding: 80rpx 40rpx;
  text-align: center;
}

/* 标题 */
.title {
  font-size: 36rpx;
  margin-bottom: 60rpx;
  color: #333;
}

/* 头像按钮 */
.avatar-button {
  padding: 0;
  border: none;
  background: transparent;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  object-fit: cover;
}

.avatar-tip {
  font-size: 26rpx;
  color: #888;
  margin-top: 20rpx;
}

/* 昵称区域 */
.nickname-section {
  margin-top: 60rpx;
}

.nickname-input {
  width: 80%;
  margin: 0 auto;
  padding: 20rpx;
  font-size: 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  background: #fafafa;
}

.placeholder-class {
  color: #999;
}

/* 微信昵称按钮 */
.nickname-btn {
  margin-top: 26rpx;
  font-size: 28rpx;
  color: #07c160;
  background-color: #e8f7ee;
  border-radius: 40rpx;
  padding: 16rpx 0;
  width: 70%;
  text-align: center;
}

/* 保存按钮 */
.save-btn {
  margin-top: 80rpx;
  width: 70%;
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  border-radius: 50rpx;
  padding: 20rpx 0;
}
