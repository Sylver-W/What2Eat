/* pages/dishDetail/index.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 菜品头部 */
.dish-header {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  padding: 30rpx;
  color: #fff;
}

.dish-name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.dish-location {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.price-rating {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
}

.price .label,
.rating .label {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.price .value {
  font-size: 48rpx;
  font-weight: bold;
  color: #e93b3d;
}

.stars {
  display: flex;
  align-items: center;
}

.rating-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 15rpx;
  color: #ff952d;
}

.rating-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.description,
.tags {
  margin-bottom: 30rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: #f0f9ff;
  color: #07c160;
  border-radius: 8rpx;
  font-size: 26rpx;
}

/* 评论区域 */
.comments-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.section-header .title {
  font-size: 34rpx;
  margin: 0;
}

.count {
  font-size: 28rpx;
  color: #999;
}

.add-comment-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  border: 1rpx dashed #ddd;
}

.btn-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 10rpx;
}

/* 评论列表 */
.comments-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-detail {
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.comment-images {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.comment-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
}

/* 评论操作 */
.comment-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  color: #999;
}

.action-text {
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 暂无评论 */
.no-comments {
  text-align: center;
  padding: 60rpx 0;
}

.no-data-img {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.tip {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #07c160;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

/* 弹窗样式 */
.comment-popup {
  padding: 40rpx 30rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.popup-header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin: 0;
}

.popup-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rating-input {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.rating-input > text:first-child {
  font-size: 30rpx;
  color: #333;
  margin-right: 30rpx;
}

.rating-value {
  font-size: 28rpx;
  color: #ff952d;
  margin-left: 30rpx;
}

.content-input {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.submit-btn {
  margin-top: auto;
}

/* 图片加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 400rpx;
  background: #f5f5f5;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  color: #ddd;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}