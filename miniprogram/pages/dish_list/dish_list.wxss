/* 保持你原来的样式完全不变 */
.page {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding: 0rpx;
}

/* 食堂卡片 */
.canteen-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.06);
}

.c-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 20rpx;
}

.c-item {
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}

.c-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 搜索框 */
.search-wrapper {
  margin: 20rpx 20rpx;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  margin: 20rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
}

.sort-item {
  font-size: 28rpx;
  color: #333;
}

/* 菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-card {
  display: flex;
  background: #ffffff;
  margin: 15rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  position: relative;
}

.dish-img {
  width: 200rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dish-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 10rpx;
}

.tag {
  margin-left: 10rpx;
  margin-bottom: 5rpx;
}

.dish-desc {
  font-size: 26rpx;
  color: #666;
  margin: 10rpx 0 20rpx 0;
  line-height: 1.4;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #ff6720;
  font-size: 32rpx;
  font-weight: 700;
}

.rate-box {
  display: flex;
  align-items: center;
}

.rate-count {
  font-size: 24rpx;
  color: #888;
  margin-left: 4rpx;
}

/* 下架状态 */
.soldout {
  position: absolute;
  right: 40rpx;
  bottom: 30rpx;
  font-size: 26rpx;
  color: #999;
}