/* pages/search/index.wxss */

/* 页面基础样式 */
.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-top: 40rpx;
  box-sizing: border-box;
}

/* 查询窗口容器 */
.search-container {
  width: 90%;
  max-width: 700rpx;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s ease;
  height: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  flex: 1;
  position: relative;
}

.search-box:focus-within {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 48rpx;
  line-height: 48rpx;
  background: transparent;
  padding-right: 40rpx;
}

.placeholder {
  color: #999;
  font-size: 30rpx;
}

/* 清除图标样式 */
.clear-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e0e0e0;
  border-radius: 50%;
  opacity: 0.7;
  z-index: 10;
}

.clear-icon:active {
  opacity: 1;
  transform: translateY(-50%) scale(0.95);
}

.clear-img {
  width: 20rpx;
  height: 20rpx;
}

/* 取消按钮样式 */
.cancel-btn {
  font-size: 30rpx;
  color: #333;
  margin-left: 20rpx;
  padding: 10rpx 12rpx;
  transition: all 0.3s ease;
  opacity: 0.8;
  border-radius: 8rpx;
  min-width: 60rpx;
  text-align: center;
}

.cancel-btn:active {
  opacity: 1;
  background-color: rgba(0, 0, 0, 0.05);
}

/* 搜索结果区域 */
.search-results {
  width: 90%;
  max-width: 700rpx;
  margin: 0 auto;
}

.results-count {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 菜品卡片 */
.dish-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.dish-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 菜品图片 */
.dish-image-container {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 30rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
}

/* 菜品内容 */
.dish-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 菜品头部：名称和标签 */
.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
  flex: 1;
}

.meal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
  margin-left: 20rpx;
}

.meal-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 300; 
  border: 1rpx solid #7b7a7a; 
}

/* 菜品描述 */
.dish-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 菜品价格 */
.dish-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 底部信息 */
.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 地点 */
.location-text {
  font-size: 26rpx;
  color: #888;
}

/* 评分 */
.rating {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rating-text {
  font-size: 26rpx;
  color: #ff952d;
  font-weight: 600;
}

/* 无结果提示 */
.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.no-results-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.no-results-hint {
  font-size: 28rpx;
  color: #999;
}

/* 添加菜品建议 */
.add-suggestion {
  text-align: center;
  padding: 30rpx 0 50rpx 0;
  background-color: #f8f8f8;
  border-top: 1rpx solid #e0e0e0;
  width: 100%;
  position: fixed;  
  bottom: 0;
  left: 0;
  z-index: 80;
}


.add-text {
  font-size: 26rpx;
  color: #999;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background-color: #f8f8f8;
  
}

.add-text:active {
  background-color: #f0f0f0;
  color: #666;
}

/* 给页面主体添加底部内边距，防止内容被遮挡 */
.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-top: 40rpx;
  padding-bottom: 110rpx;  
  box-sizing: border-box;
}
