<!--pages/search/index.wxml-->
<view class="page">
  <!-- 唯一查询框 - 顶部居中 -->
  <view class="search-container">
    <view class="search-box">
      <!-- 搜索图标 -->
      <image src="/images/icon/search.png" class="search-icon"></image>
      
      <!-- 输入框 -->
      <input 
        class="search-input" 
        placeholder="搜索菜品" 
        placeholder-class="placeholder"
        bindinput="onInputChange"
        bindconfirm="onSearch"
        confirm-type="search"
        value="{{query}}"
        focus="{{autoFocus}}"
      />
      
      <!-- 清除输入图标 -->
      <view 
        class="clear-icon" 
        bindtap="onClearInput"
      >
        <image src="/images/icon/clear.png" class="clear-img"></image>
      </view>
    </view>
    
    <!-- 取消按钮 -->
    <view class="cancel-btn" bindtap="onCancel">取消</view>
  </view>

  <!-- 搜索结果区域 -->
  <view class="search-results" wx:if="{{searchResults.length > 0}}">
    <view class="results-count">共找到 {{searchResults.length}} 个结果</view>
    
    <view class="results-list">
      <block wx:for="{{searchResults}}" wx:key="id">
        <!-- 菜品卡片 -->
        <view class="dish-card" bindtap="onDishTap" data-id="{{item.id}}">
          <!-- 左侧图片 -->
          <view class="dish-image-container">
            <image 
              class="dish-image" 
              src="{{item.imageUrl}}" 
              mode="aspectFill"
            ></image>
          </view>
          
          <!-- 右侧内容 -->
          <view class="dish-content">
            <!-- 名称和标签 -->
            <view class="dish-header">
              <text class="dish-name">{{item.name}}</text>
              <view class="meal-tags">
                <block wx:if="{{item.tags.breakfast}}">
                  <view class="meal-tag breakfast">早餐</view>
                </block>
                <block wx:if="{{item.tags.lunch}}">
                  <view class="meal-tag lunch">午餐</view>
                </block>
                <block wx:if="{{item.tags.dinner}}">
                  <view class="meal-tag dinner">晚餐</view>
                </block>
              </view>
            </view>
            
            <!-- 菜品描述 -->
            <view class="dish-description">{{item.description}}</view>
            
            <!-- 价格 -->
            <view class="dish-price">¥{{item.price}}</view>
            
            <!-- 底部信息：地点 + 评分 -->
            <view class="dish-footer">
              <text class="location-text">{{item.location}}</text>
              
              <view class="rating">
                <!-- 使用 van-rate 组件 -->
                <van-rate 
                  value="{{item.rating}}" 
                  readonly 
                  size="12"
                  color="#ffd700"  
                  void-color="#eee" 
                  void-icon="star"  
                  icon="star"       
                />
                <text class="rating-text">{{item.rating}}</text>
              </view>


            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 无结果提示 -->
  <view class="no-results" wx:if="{{hasSearched && searchResults.length === 0}}">
    <text class="no-results-text">未找到相关菜品</text>
    <text class="no-results-hint">尝试其他关键词搜索</text>
  </view>

  <!-- 添加菜品 -->
  <view class="add-suggestion">
    <text class="add-text" bindtap="onAddSuggestion">没找到？点击添加菜品补充建议</text>
  </view>
</view>