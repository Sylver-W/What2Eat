.canteen-page {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 165rpx;
}

.search-box {
  margin-bottom: 30rpx;
}

.canteen-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.canteen-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.canteen-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.canteen-info {
  flex: 1;
}

.canteen-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.canteen-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.canteen-rating {
  display: flex;
  align-items: center;
}

.rating-text {
  font-size: 24rpx;
  color: #ff6b35;
  margin-left: 8rpx;
  font-weight: bold;
}

.canteen-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.canteen-location {
  margin: 0 16rpx 0 8rpx;
}

.canteen-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.canteen-status.open {
  background: #e8f5e8;
  color: #07c160;
}

.canteen-status.closed {
  background: #fef0f0;
  color: #ee0a24;
}

.business-hours {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #888;
}

.hours-text {
  margin-left: 8rpx;
}

.featured-dishes {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.dishes-label {
  color: #999;
}

/* 新增：评分人数样式 */
.rating-count {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}