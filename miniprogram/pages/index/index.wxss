/* 固定内容块 */
.content-box {
  position: absolute;
  top: 430rpx;
  left: 0;
  right: 0;

  height: 850rpx;  /* ←←← 固定高度 */
  background: #f3f3f3;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 10;
  overflow: hidden; /* ←←← 禁止滚动 */
}

/* 快捷入口卡片 */
.shortcut-card {
  margin: 40rpx 30rpx 0;
  background: #ffffff;
  display: flex;
  border-radius: 20rpx;
  padding: 20rpx 0;
}
.shortcut-item {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
}
.shortcut-icon {
  width: 60rpx;
  height: 60rpx;
}
.divider {
  width: 2rpx;
  background: #e5e5e5;
  height: 100rpx;
}

/* 简介卡片 */
.intro-card {
  background: #ffffff;
  margin: 30rpx;
  padding: 20rpx;
  border-radius: 20rpx;
}
.intro-title {
  font-size: 32rpx;
  font-weight: bold;
}
.intro-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
}
.intro-detail {
  margin-top: 20rpx;
  color: #3a7afe;
  font-size: 26rpx;
}

/* 特色菜 */
.section-title {
  margin: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 横向滚动 */
.dish-scroll {
  white-space: nowrap;
  padding-left: 30rpx;
}
.dish-card {
  width: 300rpx;
  display: inline-block;
  margin-right: 20rpx;
  background: white;
  border-radius: 20rpx;
}
.dish-img {
  width: 100%;
  height: 200rpx;
}
.dish-name {
  font-size: 28rpx;
  margin: 16rpx;
}
.dish-price {
  font-size: 24rpx;
  margin: 0 16rpx 16rpx;
  color: #666;
}
