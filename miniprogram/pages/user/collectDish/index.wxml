<view class="collect-container">
  <!-- 收藏菜品列表 -->
  <scroll-view 
    class="dish-list-scroll" 
    scroll-y 
    enable-back-to-top
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    bindrefresherrefresh="onPullDownRefresh"
    refresher-triggered="{{isRefreshing}}"
  >
    <view class="dish-list">
      <block wx:for="{{dishList}}" wx:key="_id">
        <view 
          class="dish-card" 
          data-dish="{{item}}" 
          bindtap="goDishDetail"
        >
          <!-- 菜品图片 -->
          <view class="dish-image-wrapper">
            <image 
              class="dish-image" 
              src="{{item.dishImage || '/images/default-dish.jpg'}}" 
              mode="aspectFill"
            />
            <view class="dish-status" wx:if="{{!item.isAvailable}}">已下架</view>
          </view>
          
          <!-- 菜品信息 -->
          <view class="dish-info">
            <view class="dish-header">
              <text class="dish-name">{{item.dishName}}</text>
              <text class="dish-price">￥{{item.formattedPrice}}</text>
            </view>
            
            <view class="dish-meta">
              <view class="dish-canteen">
                <van-icon name="shop-o" size="14" color="#666" />
                <text class="canteen-text">{{item.canteenName}}</text>
              </view>
              
              <view class="dish-stats">
                <view class="stat-item">
                  <van-icon name="star" size="14" color="#ffc107" />
                  <text class="stat-text">{{item.formattedRating}}</text>
                </view>
                <view class="stat-item">
                  <van-icon name="like-o" size="14" color="#ff4444" />
                  <text class="stat-text">{{item.favourCount}}</text>
                </view>
              </view>
            </view>
            
            <!-- 标签展示 -->
            <view class="dish-tags" wx:if="{{item.dishTags && item.dishTags.length > 0}}">
              <block wx:for="{{item.dishTags}}" wx:key="*this">
                <view class="dish-tag">{{item}}</view>
              </block>
            </view>
            
            <!-- 菜品描述 -->
            <text class="dish-desc" wx:if="{{item.shortDescription}}">
              {{item.shortDescription}}
            </text>
          </view>
          
          <!-- 取消收藏按钮 -->
          <view 
            class="collect-action" 
            data-dish="{{item}}" 
            bindtap="cancelCollect"
          >
            <van-icon name="star" size="20" color="#ffc107" />
            <text class="collect-text">已收藏</text>
          </view>
          -->
        </view>
        
        <!-- 取消收藏按钮 -->
        <view class="cancel-btn" bindtap="onCancelFavourite" data-id="{{item.id}}" data-dishid="{{item.dishId}}" data-index="{{index}}" catchtap>
          <van-icon name="close" size="16px" color="#999" />
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && favouriteList.length === 0}}" class="empty">
    <image src="/images/no-data.png" class="empty-img"></image>
    <text class="empty-text">暂无收藏</text>
    <text class="empty-tip">去发现更多美食吧</text>
  </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{dishList.length === 0 && !isLoading}}">
      <image class="empty-icon" src="/images/icon/icon-empty-collect.png"></image>
      <text class="empty-text">暂无收藏菜品</text>
      <text class="empty-hint">发现喜欢的菜品，点亮小星星吧</text>
      <button class="empty-btn" bindtap="goToHome">去首页逛逛</button>
    </view>
  </scroll-view>
</view>