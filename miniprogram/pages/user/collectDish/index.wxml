<view class="page">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">我的收藏</text>
    <text class="count" wx:if="{{totalCount > 0}}">({{totalCount}})</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && favouriteList.length === 0}}" class="loading">
    <van-loading size="24px" vertical>加载中...</van-loading>
  </view>

  <!-- 收藏列表 -->
  <view wx:if="{{favouriteList.length > 0}}" class="favourite-list">
    <block wx:for="{{favouriteList}}" wx:key="id" wx:for-index="index">
      <view class="favourite-item" bindtap="goDishDetail" data-id="{{item.dishId}}" data-favouriteid="{{item.id}}">
        <!-- 菜品图片 -->
        <image class="dish-image" src="{{item.dishImage}}" mode="aspectFill"></image>
        
        <view class="dish-info">
          <!-- 菜品名称和价格 -->
          <view class="dish-header">
            <text class="dish-name">{{item.dishName}}</text>
            <text class="dish-price">¥{{item.dishPrice}}</text>
          </view>
          
          <!-- 食堂位置 -->
          <text class="dish-location">{{item.dishLocation}}</text>
          
          <!-- 评分 -->
          <view class="dish-rating">
            <van-rate value="{{item.dishRating}}" size="12" readonly allow-half />
            <text class="rating-text">{{item.dishRating}}</text>
          </view>
          
          <!-- 收藏时间 -->
          <!--
          <view class="favourite-time">
            <van-icon name="clock-o" size="12px" color="#999" />
            <text class="time-text">{{formatTime(item.createTime)}}</text>
          </view>
          -->
        </view>
        
        <!-- 取消收藏按钮 -->
        <view class="cancel-btn" bindtap="onCancelFavourite" data-id="{{item.id}}" data-dishid="{{item.dishId}}" data-index="{{index}}" catchtap>
          <van-icon name="close" size="16px" color="#999" />
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && favouriteList.length === 0}}" class="empty">
    <image src="/images/no-data.png" class="empty-img"></image>
    <text class="empty-text">暂无收藏</text>
    <text class="empty-tip">去发现更多美食吧</text>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore && favouriteList.length > 0}}" class="load-more">
    <van-loading size="16px" vertical wx:if="{{loading}}">加载中...</van-loading>
    <text wx:else>上拉加载更多</text>
  </view>
</view>