<view class="collect-container">
  <!-- 顶部标题 -->
  <view class="header">
    <view class="title">我的收藏</view>
    <view class="count" wx:if="{{totalCount > 0}}">{{totalCount}}个收藏</view>
  </view>

  <!-- 收藏菜品列表 -->
  <scroll-view 
    class="dish-list-scroll" 
    scroll-y 
    enable-back-to-top
    refresher-enabled="{{true}}"
    bindrefresherrefresh="onPullDownRefresh"
    refresher-triggered="{{isRefreshing}}"
  >
    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{isLoading}}">
      <van-loading size="24px" type="spinner" color="#07c160" />
      <text class="loading-text">正在加载收藏...</text>
    </view>

    <!-- 菜品列表 -->
    <view class="dish-list" wx:if="{{!isLoading}}">
      <block wx:for="{{dishList}}" wx:key="_id">
        <view class="dish-card" data-dish="{{item}}" bindtap="goDishDetail">
          <!-- 菜品图片 -->
          <view class="dish-image-wrapper">
            <image 
              class="dish-image" 
              src="{{item.dishImage}}" 
              mode="aspectFill"
            />
          </view>
          
          <!-- 菜品信息 -->
          <view class="dish-info">
            <view class="dish-header">
              <text class="dish-name">{{item.dishName}}</text>
              <text class="dish-price">￥{{item.formattedPrice}}</text>
            </view>
            
            <view class="dish-meta">
              <view class="dish-canteen">
                <van-icon name="shop-o" size="14" color="#666" />
                <text class="canteen-text">{{item.canteenName}}</text>
              </view>
              
              <view class="dish-stats">
                <view class="stat-item">
                  <van-icon name="star" size="14" color="#ffc107" />
                  <text class="stat-text">{{item.formattedRating}}</text>
                </view>
              </view>
            </view>
            
            <!-- 标签展示 -->
            <view class="dish-tags" wx:if="{{item.dishTags && item.dishTags.length > 0}}">
              <block wx:for="{{item.dishTags}}" wx:key="*this">
                <view class="dish-tag">{{item}}</view>
              </block>
            </view>
            
            <!-- 菜品描述 -->
            <text class="dish-desc" wx:if="{{item.dishDescription}}">
              {{item.dishDescription.length > 30 ? item.dishDescription.substring(0, 30) + '...' : item.dishDescription}}
            </text>
          </view>
          
          <!-- 取消收藏按钮 -->
          <view class="collect-action" data-dish="{{item}}" bindtap="cancelCollect">
            <van-icon name="star" size="20" color="#ffc107" />
            <text class="collect-text">已收藏</text>
          </view>
        </view>
      </block>
    </view>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore && favouriteList.length > 0}}" class="load-more">
    <van-loading size="16px" vertical wx:if="{{loading}}">加载中...</van-loading>
    <text wx:else>上拉加载更多</text>
  </view>
  </scroll-view> 
</view>