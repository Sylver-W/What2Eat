<view class="collect-container">
  <!-- 【已移除自定义顶部导航栏，使用小程序原生导航栏】 -->

  <!-- 收藏菜品列表 -->
  <scroll-view 
    class="dish-list-scroll" 
    scroll-y 
    enable-back-to-top
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    bindrefresherrefresh="onPullDownRefresh"
    refresher-triggered="{{isRefreshing}}"
  >
    <view class="dish-list">
      <block wx:for="{{dishList}}" wx:key="dishId">
        <view class="dish-card" data-dish-id="{{item.dishId}}" bindtap="goDishDetail">
          <!-- 菜品图片 -->
          <view class="dish-image-wrapper">
            <image 
              class="dish-image" 
              src="{{item.images && item.images[0] ? item.images[0] : '/images/default-dish.jpg'}}" 
              mode="aspectFill"
            />
            <view class="dish-status" wx:if="{{!item.isAvailable}}">已下架</view>
          </view>
          
          <!-- 菜品信息 -->
          <view class="dish-info">
            <view class="dish-header">
              <text class="dish-name">{{item.name}}</text>
              <text class="dish-price">￥{{item.price.toFixed(2)}}</text>
            </view>
            
            <view class="dish-meta">
              <view class="dish-canteen">
                <van-icon name="shop-o" size="14" color="#666" />
                <text class="canteen-text">{{item.canteenName || '未知食堂'}}</text>
              </view>
              
              <view class="dish-stats">
                <view class="stat-item">
                  <van-icon name="star" size="14" color="#ffc107" />
                  <text class="stat-text">{{item.rating.toFixed(1)}}</text>
                </view>
                <view class="stat-item">
                  <van-icon name="like-o" size="14" color="#ff4444" />
                  <text class="stat-text">{{item.favourCount}}</text>
                </view>
              </view>
            </view>
            
            <!-- 标签展示 -->
            <view class="dish-tags" wx:if="{{item.tags && item.tags.length > 0}}">
              <block wx:for="{{item.tags.slice(0, 3)}}" wx:key="*this">
                <view class="dish-tag">{{item}}</view>
              </block>
            </view>
            
            <!-- 菜品描述 -->
            <text class="dish-desc" wx:if="{{item.description}}">
              {{item.description.length > 30 ? item.description.substring(0, 30) + '...' : item.description}}
            </text>
          </view>
          
          <!-- 取消收藏按钮 -->
          <view class="collect-action" data-dish-id="{{item.dishId}}" bindtap="cancelCollect">
            <van-icon name="star" size="20" color="#ffc107" />
            <text class="collect-text">已收藏</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{!hasMore && dishList.length > 0}}">
      <text class="load-text">没有更多收藏了</text>
    </view>
    <view class="load-more" wx:if="{{isLoadingMore}}">
      <van-loading size="20px" type="spinner" color="#07c160" />
      <text class="load-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{dishList.length === 0 && !isLoading}}">
      <image class="empty-icon" src="/images/icon/icon-empty-collect.png"></image>
      <text class="empty-text">暂无收藏菜品</text>
      <text class="empty-hint">发现喜欢的菜品，点亮小星星吧</text>
      <button class="empty-btn" bindtap="goToHome">去首页逛逛</button>
    </view>
  </scroll-view>
</view>
