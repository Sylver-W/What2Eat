/* 收藏菜品页面样式 */
.collect-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 滚动容器 */
.dish-list-scroll {
  height: calc(100vh - 120rpx);
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx 30rpx;
}

.dish-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.dish-image-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
}

/* 菜品信息 */
.dish-info {
  flex: 1;
  min-width: 0; /* 防止内容溢出 */
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.dish-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b00;
  flex-shrink: 0;
}

.dish-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.dish-canteen {
  display: flex;
  align-items: center;
  flex: 1;
}

.canteen-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 4rpx;
}

/* 标签 */
.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.dish-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 菜品描述 */
.dish-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 收藏操作 */
.collect-action {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 20rpx;
  border-left: 2rpx solid #f0f0f0;
}

.collect-text {
  font-size: 22rpx;
  color: #ffc107;
  margin-top: 8rpx;
}

/* 加载更多 */
.load-more {
  padding: 40rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.load-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #07c160;
  color: white;
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .dish-list {
    padding: 20rpx;
  }
  
  .dish-card {
    padding: 20rpx;
  }
  
  .dish-image-wrapper {
    width: 140rpx;
    height: 140rpx;
    margin-right: 20rpx;
  }
  
  .dish-name {
    font-size: 30rpx;
  }
  
  .dish-price {
    font-size: 30rpx;
  }
}
