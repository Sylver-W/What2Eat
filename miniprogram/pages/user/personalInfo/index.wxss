/* 页面容器 */
.info-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  padding-bottom: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  height: calc(44px + {{statusBarHeight}}px); /* 导航栏基础高度 + 状态栏高度 */
  box-sizing: border-box;
}
.back-icon {
  font-size: 36rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  flex: 1; /* 让标题居中 */
}
.save-btn {
  font-size: 28rpx;
  color: #3a7afe;
  min-width: 80rpx; /* 避免按钮被压缩 */
}

/* 信息项通用样式 */
.info-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 25rpx 30rpx;
}
/* 分隔线 */
.line {
  border-top: 1rpx solid #f5f5f5;
}
.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-left: auto;
}

/* 输入框 */
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

/* 选择器 */
.picker {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.picker-value {
  display: inline-block;
}