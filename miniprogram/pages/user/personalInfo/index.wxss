.profile-container {
  padding: 30rpx 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头像样式 */
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid #eee;
  margin-bottom: 10rpx;
}
.edit-avatar {
  font-size: 24rpx;
  color: #666;
}

/* 表单样式 */
.form-wrapper {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}
.form-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child {
  border-bottom: none;
}
.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 80rpx;
}
.form-picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.picker-content {
  text-align: right;
  color: #666;
}

/* 按钮样式 */
.save-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #101010;
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
}
.save-btn::after {
  border: none;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

/* 确保表单项正确显示 */
.picker-content {
  font-size: 32rpx;
  color: #333;
  padding: 20rpx 0;
}

/* 头像区域优化 */
.avatar {
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.edit-avatar {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #07c160;
}