<view class="info-container">
  <!-- 顶部导航栏 -->
  <!-- 顶部自定义导航栏：增加状态栏高度的 padding -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <van-icon name="arrow-left" bindtap="goBack" class="back-icon" />
    <view class="nav-title">个人信息</view>
    <view class="save-btn" bindtap="saveInfo">保存</view>
  </view>

  <!-- 头像区域 -->
  <view class="info-item">
    <view class="label">头像</view>
    <image class="avatar" src="/images/avatar.jpg" bindtap="chooseAvatar"></image>
  </view>

  <!-- 昵称 -->
  <view class="info-item line">
    <view class="label">昵称</view>
    <input class="input" value="集锦园热干面" placeholder="请输入昵称" bindinput="onNicknameChange" />
  </view>

  <!-- 性别 -->
  <view class="info-item line">
    <view class="label">性别</view>
    <picker class="picker" mode="selector" range="{{genderList}}" bindchange="onGenderChange" value="{{genderIndex}}">
      <view class="picker-value">{{genderList[genderIndex]}}</view>
    </picker>
  </view>

  <!-- 手机号 -->
  <view class="info-item line">
    <view class="label">手机号</view>
    <input class="input" value="19729922849" type="number" disabled />
  </view>

  <!-- 宿舍区 -->
  <view class="info-item line">
    <view class="label">宿舍区</view>
    <input class="input" value="沁苑" placeholder="请输入宿舍区" bindinput="onDormChange" />
  </view>

  <!-- 个人口味 -->
  <view class="info-item line">
    <view class="label">个人口味</view>
    <input class="input" value="不吃香菜" placeholder="请输入口味偏好" bindinput="onTasteChange" />
  </view>
</view>