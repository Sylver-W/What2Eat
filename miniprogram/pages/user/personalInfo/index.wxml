<!-- personalInfo/index.wxml -->
<view class="profile-container">
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-text">加载中...</view>
  </view>
  
  <!-- 内容区域（非加载状态时显示） -->
  <view wx:else>
    <!-- 头像编辑区域 -->
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image 
        class="avatar" 
        src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
        mode="aspectFill"
      ></image>
      <view class="edit-avatar">更换头像</view>
    </view>

    <!-- 表单区域 -->
    <view class="form-wrapper">
      <view class="form-item">
        <label class="form-label">昵称</label>
        <input 
          class="form-input" 
          value="{{userInfo.nickname}}" 
          bindinput="onNicknameChange" 
          placeholder="请输入昵称" 
          maxlength="10"
        />
      </view>
      <view class="form-item">
        <label class="form-label">性别</label>
        <picker 
          class="form-picker" 
          range="{{genderOptions}}" 
          value="{{userInfo.gender}}" 
          bindchange="onGenderChange"
        >
          <view class="picker-content">
            {{userInfo.gender !== undefined ? genderOptions[userInfo.gender] : '请选择'}}
          </view>
        </picker>
      </view>
      <view class="form-item">
        <label class="form-label">手机号</label>
        <input 
          class="form-input" 
          value="{{userInfo.phone}}" 
          bindinput="onPhoneChange" 
          placeholder="请输入手机号" 
          type="number"
          maxlength="11"
        />
      </view>
      <view class="form-item">
        <label class="form-label">宿舍区</label>
        <input 
          class="form-input" 
          value="{{userInfo.dormArea}}" 
          bindinput="onDormChange" 
          placeholder="如：紫菘公寓、韵苑" 
          maxlength="10"
        />
      </view>
      <view class="form-item">
        <label class="form-label">口味偏好</label>
        <input 
          class="form-input" 
          value="{{userInfo.tastePreferences}}" 
          bindinput="onTasteChange" 
          placeholder="如：重口味、清淡、无辣不欢" 
          maxlength="20"
        />
      </view>
    </view>

    <!-- 保存按钮 -->
    <button class="save-btn" bindtap="saveProfile">保存个人资料</button>
  </view>
</view>