/* mycomment.wxss */
.comment-container {
  height: 100vh;
  background-color: #f5f5f5;
}

.comment-list-scroll {
  height: 100%;
}

.total-count-tip {
  padding: 20rpx 30rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-bottom: 1rpx solid #eee;
}

.comment-list {
  padding: 20rpx;
}

.comment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.canteen-name {
  font-size: 26rpx;
  color: #666;
}

.rating-section {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rating-stars {
  display: flex;
  align-items: center;
}

.rating-text {
  font-size: 26rpx;
  color: #ff952d;
  font-weight: bold;
}

.comment-content-wrapper {
  margin-bottom: 20rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.comment-images {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.comment-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.comment-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.like-count {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.like-text {
  font-size: 24rpx;
  color: #666;
}

.comment-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.delete-btn {
  color: #ff4444;
}

.load-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.load-text {
  margin-left: 10rpx;
}

.empty-state {
  padding: 100rpx 30rpx;
  text-align: center;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}