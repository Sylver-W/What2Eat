/* 我的评价页面样式 */
.comment-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 滚动容器 */
.comment-list-scroll {
  height: 100vh;
}

/* 评价列表 */
.comment-list {
  padding: 20rpx 30rpx;
}

/* 评价卡片 */
.comment-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 头部 */
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.canteen-name {
  font-size: 26rpx;
  color: #666;
}

.rating-section {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.star {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rating-text {
  font-size: 24rpx;
  color: #ffc107;
  font-weight: 500;
}

/* 评价内容 */
.comment-content-wrapper {
  margin-bottom: 20rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.comment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.comment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

/* 底部 */
.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.comment-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.like-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.like-text {
  font-size: 24rpx;
  color: #666;
}

/* 操作按钮 */
.comment-actions {
  display: flex;
  gap: 30rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: #f9f9f9;
}

.action-btn text {
  font-size: 26rpx;
}

.delete-btn {
  color: #ff4444 !important;
  background: #ffebee !important;
}

/* 加载更多 */
.load-more {
  padding: 40rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.load-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #07c160;
  color: white;
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .comment-list {
    padding: 20rpx;
  }
  
  .comment-card {
    padding: 20rpx;
  }
  
  .dish-name {
    font-size: 30rpx;
  }
  
  .comment-content {
    font-size: 26rpx;
  }
  
  .action-btn {
    padding: 8rpx 16rpx;
  }
}