/* 菜品补充页面样式 - 与"我的"页面风格一致 */
.add-dish-container {
  min-height: 100vh;
  background: #f8f8f8;
}

/* 页面头部 - 与"我的"页面标题栏风格一致 */
.page-header {
  background: white;
  padding: 30rpx 0 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.page-header-inner {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  position: relative;
}

.back-btn {
  padding: 10rpx;
  margin-right: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

/* 滚动容器 */
.form-scroll {
  height: calc(100vh - 120rpx);
}

.form-container {
  padding: 0 30rpx 120rpx;
}

/* 表单区块 */
.form-section {
  background: white;
  padding: 30rpx;
  margin: 20rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.section-required {
  color: #ff4444;
  font-size: 28rpx;
  margin-left: 8rpx;
}

.section-optional {
  color: #999;
  font-size: 26rpx;
  margin-left: 8rpx;
}

.section-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* 输入框样式 - 与"我的"页面输入框一致 */
.form-input {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  color: #333;
  padding: 0 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #07c160;
  background: white;
}

.input-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 选择器样式 */
.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  color: #333;
  padding: 0 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.picker-input.placeholder {
  color: #ccc;
}

/* 价格输入样式 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.price-unit {
  font-size: 32rpx;
  color: #ff6b00;
  font-weight: 500;
  margin-right: 10rpx;
}

.price-input {
  flex: 1;
  height: 100%;
  padding: 0;
  border: none;
  background: transparent;
}

.price-text {
  font-size: 32rpx;
  color: #666;
  margin-left: 10rpx;
}

/* 文本域样式 */
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-textarea:focus {
  border-color: #07c160;
  background: white;
}

.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 标签网格 */
.tags-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.tag-item {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 35rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 24rpx;
  color: #666;
  position: relative;
  transition: all 0.2s;
}

.tag-item:active {
  background: #e8e8e8;
}

.tag-selected {
  background: #07c160;
  border-color: #07c160;
  color: white;
}

.tag-check {
  position: absolute;
  right: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-text {
  padding: 0 30rpx;
  text-align: center;
}

/* 已选择标签样式 */
.selected-tags {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  border: 1rpx solid #e0e0e0;
}

.selected-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 15rpx;
  display: block;
}

.selected-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  background: #e8f8ef;
  border-radius: 30rpx;
  padding: 8rpx 35rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: #07c160;
  position: relative;
}

.remove-tag {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff4444;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tags-count {
  font-size: 24rpx;
  color: #999;
  display: block;
  text-align: center;
  padding-top: 10rpx;
  border-top: 1rpx solid #e0e0e0;
}

/* 自定义标签 */
.custom-tag {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e0e0e0;
}

.custom-tag-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.custom-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.custom-hint {
  font-size: 24rpx;
  color: #999;
}

.custom-input-wrapper {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.custom-input {
  flex: 1;
  height: 70rpx;
  font-size: 26rpx;
  color: #333;
  padding: 0 20rpx;
  background: #f9f9f9;
  border-radius: 35rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.custom-input:focus {
  border-color: #07c160;
  background: white;
}

.add-tag-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 35rpx;
  background: #07c160;
  color: white;
  font-size: 26rpx;
  border-radius: 35rpx;
  border: none;
}

.add-tag-btn.disabled {
  background: #ccc;
  color: #999;
}

/* 图片上传区域 */
.image-upload {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-image {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image-btn {
  background: #f9f9f9;
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.add-count {
  font-size: 22rpx;
  color: #ccc;
}

/* 提交区域 */
.submit-section {
  background: white;
  padding: 40rpx 30rpx;
  margin: 20rpx 0;
  border-radius: 16rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
  color: #999;
}

.submit-tips {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 15rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-left: 10rpx;
  flex: 1;
}

/* 占位符样式 */
.placeholder {
  color: #cccccc !important;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .page-header-inner,
  .form-container {
    padding: 0 20rpx;
  }
  
  .form-section {
    padding: 24rpx 20rpx;
  }
  
  .tags-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 15rpx;
  }
  
  .page-title {
    font-size: 32rpx;
  }
  
  .section-title {
    font-size: 30rpx;
  }
}