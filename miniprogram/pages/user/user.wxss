/* 页面容器：去掉底部 Tabbar 高度，适配全局 Tabbar */
.mine-container {
  background-color: #f7f8f7;
  min-height: calc(100vh - 100rpx); /* 预留底部全局 Tabbar 高度 */
  padding: 30rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.user-name {
  font-size: 32rpx;
  font-weight: bold;
}
.user-phone {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
}

/* 数据统计 */
.stats {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
  margin: 20rpx 0;
}
.stat-item {
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 功能列表 */
.func-item {
  background: #fff;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  padding: 40rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.func-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}
.func-text {
  flex: 1;
  font-size: 30rpx;
}
.arrow {
  color: #cccccc; /* 与首页箭头颜色一致 */
}