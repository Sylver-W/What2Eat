/* user.wxss - 完整修改版 */

/* 页面容器 */
.mine-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding-bottom: 100rpx;
}

/* 容器布局 */
.user-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 20rpx;
}

/* 头像外层（用于点击登录） */
.avatar-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
}

/* 头像 */
.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

/* 未登录时覆盖文字 */
.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.45);
  color: white;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

/* 右侧昵称文本 */
.user-text {
  display: flex;
  flex-direction: column;
  margin-left: 30rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 数据统计区域 */
.stats {
  display: flex;
  background: white;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  border-bottom: 2rpx solid #f0f0f0;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-right: 2rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

/* 功能列表 */
.func-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: white;
  margin-bottom: 2rpx;
  position: relative;
}

.func-item:active {
  background: #f9f9f9;
}

.func-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.func-text {
  font-size: 32rpx;
  color: #333;
  flex: 1;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 底部导航栏区域 */
.van-tabbar {
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 响应式调整 */
@media (max-width: 375px) {
  .user-info {
    padding: 30rpx 20rpx;
  }
  
  .avatar {
    width: 100rpx;
    height: 100rpx;
  }
  
  .user-name-input {
    font-size: 32rpx !important;
    padding: 10rpx 14rpx !important;
  }
  
  .func-item {
    padding: 24rpx 20rpx;
  }
}